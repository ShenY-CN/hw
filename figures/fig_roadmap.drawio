        <mxCell id="c1" parent="1" value="载荷&lt;br&gt;+ 能量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontSize=15;fontFamily=PingFang SC;align=center;verticalAlign=middle;" vertex="1">
          <mxGeometry x="25" y="337" width="150" height="82" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" value="+ 硬时限&lt;br&gt;+ 共享设备" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontSize=15;fontFamily=PingFang SC;align=center;verticalAlign=middle;" vertex="1">
          <mxGeometry x="25" y="562" width="150" height="82" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" value="+ 连续通信&lt;br&gt;+ 中继资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontSize=15;fontFamily=PingFang SC;align=center;verticalAlign=middle;" vertex="1">
          <mxGeometry x="25" y="787" width="150" height="82" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" value="+ 独立执行&lt;br&gt;+ 禁止跨组共享" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#334155;fontSize=15;fontFamily=PingFang SC;align=center;verticalAlign=middle;" vertex="1">
          <mxGeometry x="25" y="1012" width="150" height="82" as="geometry" />
        </mxCell>

        <mxCell id="q1_task" parent="1" value="&lt;b&gt;Q1｜基础能力&lt;/b&gt;&lt;br&gt;回答：单点任务能否安全完成？&lt;br&gt;如何形成可行货箱组批？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#4477AA;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="200" y="300" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="q1_method" parent="1" value="&lt;b&gt;求解过程&lt;/b&gt;&lt;br&gt;DEM净空 → 最大安全载荷二分&lt;br&gt;可行批次模式枚举 → 计数状态动态规划&lt;br&gt;目标：先少架次，再少飞行能耗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFE;strokeColor=#4477AA;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="590" y="300" width="760" height="155" as="geometry" />
        </mxCell>
        <mxCell id="q1_output" parent="1" value="&lt;b&gt;本问输出&lt;/b&gt;&lt;br&gt;逐服务区安全载荷边界&lt;br&gt;单点直送的可行组批基准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#4477AA;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1390" y="300" width="350" height="155" as="geometry" />
        </mxCell>

        <mxCell id="q2_task" parent="1" value="&lt;b&gt;Q2｜运输调度&lt;/b&gt;&lt;br&gt;多服务区、多架次配送&lt;br&gt;纳入硬时限及共享机体、电池" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F4;strokeColor=#228B8D;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="200" y="525" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="q2_method" parent="1" value="&lt;b&gt;求解过程&lt;/b&gt;&lt;br&gt;完整路线列候选 → 四种搜索方法同预算比较&lt;br&gt;固定路线 CP-SAT 排机体与电池时序&lt;br&gt;逐箱核对服务区、时限和物理可行性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF9;strokeColor=#228B8D;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="590" y="525" width="760" height="155" as="geometry" />
        </mxCell>
        <mxCell id="q2_output" parent="1" value="&lt;b&gt;本问输出&lt;/b&gt;&lt;br&gt;运输路线与逐架次安排&lt;br&gt;机体、电池时序及逐箱送达时刻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F4;strokeColor=#228B8D;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1390" y="525" width="350" height="155" as="geometry" />
        </mxCell>

        <mxCell id="q3_task" parent="1" value="&lt;b&gt;Q3｜运输—通信协同&lt;/b&gt;&lt;br&gt;在运输任务上补足通信保障&lt;br&gt;同时安排中继机与能源组件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF1E7;strokeColor=#D9813D;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="200" y="750" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="q3_method" parent="1" value="&lt;b&gt;求解过程&lt;/b&gt;&lt;br&gt;运输候选族 + 中继窗口 → 有限候选协调&lt;br&gt;直连/中继覆盖判定 → 连续区间链路证书&lt;br&gt;对归档候选逐一进行硬约束回放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F4;strokeColor=#D9813D;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="590" y="750" width="760" height="155" as="geometry" />
        </mxCell>
        <mxCell id="q3_output" parent="1" value="&lt;b&gt;本问输出&lt;/b&gt;&lt;br&gt;运输—中继联合可行候选&lt;br&gt;全过程连续通信认证结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF1E7;strokeColor=#D9813D;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1390" y="750" width="350" height="155" as="geometry" />
        </mxCell>

        <mxCell id="q4_task" parent="1" value="&lt;b&gt;Q4｜独立资源配置&lt;/b&gt;&lt;br&gt;固定 Q3 联合任务与通信关系&lt;br&gt;评估任务分组后的配置代价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECF8;strokeColor=#8064A2;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="200" y="975" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="q4_method" parent="1" value="&lt;b&gt;求解过程&lt;/b&gt;&lt;br&gt;不可拆任务组件 → 两组/三组分区穷举&lt;br&gt;按事件时刻核算各类资源并发峰值&lt;br&gt;比较配置总量、重复配置与库存缺口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F7FC;strokeColor=#8064A2;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
