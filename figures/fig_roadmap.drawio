        <mxCell id="scope" parent="1" value="范围说明：Q1 仅对单点直送模型给出精确解；Q2/Q3 结论限于实际搜索或归档的候选；Q4 固定 Q3 任务后核算分区资源。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=14;fontFamily=PingFang SC;" vertex="1">
