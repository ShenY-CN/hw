        <mxCell id="q4_output" parent="1" value="&lt;b&gt;本问输出&lt;/b&gt;&lt;br&gt;两组/三组任务划分&lt;br&gt;独立配置需求与库存缺口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECF8;strokeColor=#8064A2;strokeWidth=2;fontColor=#243447;fontSize=16;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=10;" vertex="1">
          <mxGeometry x="1390" y="975" width="350" height="155" as="geometry" />
        </mxCell>

        <mxCell id="verify" parent="1" value="&lt;b&gt;全流程回放验收与成果交付&lt;/b&gt;&lt;br&gt;逐箱目的地与时限 → 逐航次载荷、能耗和返航储备 → 机体/电池/中继资源周转 → 每个通信区间连续覆盖&lt;br&gt;形成可执行方案、配置缺口、结果表图与复现材料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#355F8A;strokeWidth=2.5;fontColor=#243447;fontSize=17;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=12;" vertex="1">
