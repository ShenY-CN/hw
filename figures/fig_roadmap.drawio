  <diagram id="d-roadmap" name="递进建模与验收链">
    <mxGraphModel dx="1800" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="山区无人机运输—通信协同的递进建模与验收链" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#1E293B;fontSize=28;fontStyle=1;fontFamily=PingFang SC;" vertex="1">
          <mxGeometry x="180" y="20" width="1440" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" value="先统一计算口径，再逐问传递方案；每一步都对应明确的中间产出与可核验依据" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#64748B;fontSize=16;fontFamily=PingFang SC;" vertex="1">
          <mxGeometry x="240" y="68" width="1320" height="28" as="geometry" />
        </mxCell>
        <mxCell id="base" parent="1" value="&lt;b&gt;统一数据与公共物理规则&lt;/b&gt;&lt;br&gt;输入：DEM、80箱与15个服务区、运输机和电池、中继设备、配送时限、通信参数&lt;br&gt;共享口径：统一节点与单位；航段净空、飞行时间和载荷能耗；SOC与充电周转；双向链路预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontColor=#243447;fontSize=17;fontFamily=PingFang SC;align=center;verticalAlign=middle;spacing=12;" vertex="1">
          <mxGeometry x="200" y="110" width="1540" height="140" as="geometry" />
        </mxCell>

        <mxCell id="constraint_title" parent="1" value="约束逐层增加" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=15;fontStyle=1;fontFamily=PingFang SC;" vertex="1">
          <mxGeometry x="20" y="260" width="160" height="34" as="geometry" />
